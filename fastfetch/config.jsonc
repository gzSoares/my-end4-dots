{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "arch",
    "type": "builtin",
    "color": { "1": "blue", "2": "blue" },
    "padding": { "top": 0, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "output": "white",
      "separator": "white"
    }
  },

  "modules": [
    // linha em branco para descer a caixa em relação ao logo
    { "type": "custom", "format": " " },

    // topo da caixa
    { "type": "custom", "format": "╭──────────╮", "outputColor": "white" },

    { "type": "title", "key": "│ \uf007 user   │", "format": "{user-name}", "keyColor": "white" },
    { "type": "uptime",   "key": "│ \uf017 uptime │", "keyColor": "white" },
    { "type": "os",       "key": "│ \uf17c distro │", "keyColor": "white" },
    { "type": "kernel",   "key": "│ \uf013 kernel │", "keyColor": "white" },
    { "type": "wm",       "key": "│ \uf2d0 wm     │", "keyColor": "white" },
    { "type": "terminal", "key": "│ \uf120 term   │", "keyColor": "white" },
    { "type": "shell",    "key": "│ \uf489 shell  │", "keyColor": "white" },
    { "type": "cpu",      "key": "│ \uf0ac cpu    │", "keyColor": "white" },

    // lista todas as GPUs (cada uma em uma linha com a mesma chave)
    { "type": "gpu", "key": "│ \uf26c gpu    │", "keyColor": "white" },

    // lista todos os discos montados
    // para limitar a pontos de montagem específicos, adicione por ex.: "folders": ["/", "/mnt/dados"]
    {
      "type": "disk",
      "key": "│ \uf0c7 disk   │",
      "keyColor": "white",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },

    { "type": "memory", "key": "│ \uf2db memory │", "keyColor": "white" },

    // base da caixa
    { "type": "custom", "format": "╰──────────╯", "outputColor": "white" }
  ]
}
